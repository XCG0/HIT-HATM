<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
  <reconnectOnConnectionFailure>true</reconnectOnConnectionFailure>
  <isolation>TRANSACTION_READ_COMMITTED</isolation>
  <batchsize>128</batchsize>
  <scalefactor>10</scalefactor>
  <terminals>16</terminals>
  <works>
    <work>
      <time>60</time>
      <rate>10000</rate>
      <warmup>10</warmup>
      <weights>45,43,4,4,4</weights>
    </work>
  </works>
  <transactiontypes>
    <transactiontype>
      <name>NewOrder</name>
    </transactiontype>
    <transactiontype>
      <name>Payment</name>
    </transactiontype>
    <transactiontype>
      <name>OrderStatus</name>
    </transactiontype>
    <transactiontype>
      <name>Delivery</name>
    </transactiontype>
    <transactiontype>
      <name>StockLevel</name>
    </transactiontype>
  </transactiontypes>
  <measurementinterval>5000</measurementinterval>
  <outputformat>json</outputformat>
  <histograms>true</histograms>
  <loaderThreads>4</loaderThreads>
  <tracefile/>
</configuration>

<?xml version="1.0"?>
<parameters>
    <!-- 数据库基本配置 -->
    <dbtype>postgres</dbtype>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://192.168.1.10:5432/benchbase</url>
    <username>benchbase_user</username>
    <password>benchbase_pass</password>
    
    <!-- 连接配置 -->
    <isolation>TRANSACTION_READ_COMMITTED</isolation>
    <batchsize>50</batchsize>
    
    <!-- SmallBank工作负载配置 -->
    <scalefactor>100000</scalefactor>  <!-- 10万个账户 -->
    <terminals>16</terminals>  <!-- 16个并发客户端 -->
    
    <!-- 测试执行配置 -->
    <works>
        <work>
            <time>300</time>  <!-- 测试时间：5分钟 -->
            <rate>unlimited</rate>
            <!-- Amalgamate,Balance,DepositChecking,TransactSaving,WriteCheck权重 -->
            <weights>15,15,25,25,20</weights>
        </work>
    </works>
    
    <!-- SmallBank事务配置 -->
    <transactiontypes>
        <transactiontype>
            <name>Amalgamate</name>
            <!-- 合并账户：将一个账户的钱转到另一个账户并删除源账户 -->
        </transactiontype>
        <transactiontype>
            <name>Balance</name>
            <!-- 余额查询：查询账户余额，测试读性能 -->
        </transactiontype>
        <transactiontype>
            <name>DepositChecking</name>
            <!-- 存款到支票账户：测试单表更新性能 -->
        </transactiontype>
        <transactiontype>
            <name>TransactSaving</name>
            <!-- 储蓄账户事务：测试条件更新性能 -->
        </transactiontype>
        <transactiontype>
            <name>WriteCheck</name>
            <!-- 写支票：从支票账户扣款，测试写性能 -->
        </transactiontype>
    </transactiontypes>
    
    <!-- SmallBank特定配置 -->
    <smallbank>
        <!-- 账户数量 -->
        <num_accounts>100000</num_accounts>
        <!-- 热点账户比例 -->
        <hotspot_percentage>10</hotspot_percentage>
        <!-- 热点访问比例 -->
        <hotspot_probability>90</hotspot_probability>
        <!-- 初始余额 -->
        <initial_balance>10000</initial_balance>
    </smallbank>
    
    <!-- 多节点事务分发配置（可选） -->
    <!--

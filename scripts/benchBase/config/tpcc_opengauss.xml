<?xml version="1.0"?>
<parameters>
    <!-- 数据库基本配置 -->
    <dbtype>postgres</dbtype>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://192.168.1.10:5432/benchbase</url>
    <username>benchbase_user</username>
    <password>benchbase_pass</password>
    
    <!-- 连接配置 -->
    <isolation>TRANSACTION_READ_COMMITTED</isolation>
    <batchsize>128</batchsize>
    
    <!-- TPC-C工作负载配置 -->
    <scalefactor>10</scalefactor>
    <terminals>64</terminals>
    
    <!-- 测试执行配置 -->
    <works>
        <work>
            <time>300</time>  <!-- 测试时间：5分钟 -->
            <rate>unlimited</rate>  <!-- 不限制TPS -->
            <weights>45,43,4,4,4</weights>  <!-- NewOrder,Payment,OrderStatus,Delivery,StockLevel权重 -->
        </work>
    </works>
    
    <!-- TPC-C事务类型配置 -->
    <transactiontypes>
        <transactiontype>
            <name>NewOrder</name>
            <!-- 新订单事务，测试数据插入性能 -->
        </transactiontype>
        <transactiontype>
            <name>Payment</name>
            <!-- 付款事务，测试数据更新性能 -->
        </transactiontype>
        <transactiontype>
            <name>OrderStatus</name>
            <!-- 订单状态查询，测试读性能 -->
        </transactiontype>
        <transactiontype>
            <name>Delivery</name>
            <!-- 配送事务，测试批量操作性能 -->
        </transactiontype>
        <transactiontype>
            <name>StockLevel</name>
            <!-- 库存水平查询，测试复杂查询性能 -->
        </transactiontype>
    </transactiontypes>
    
    <!-- 多节点读写分离配置（可选） -->
    <!--
    <read_write_split>
        <write_url>jdbc:postgresql://192.168.1.10:5432/benchbase</write_url>
        <read_urls>
            <url>jdbc:postgresql://192.168.1.11:5432/benchbase</url>
            <url>jdbc:postgresql://192.168.1.12:5432/benchbase</url>
        </read_urls>
        <read_weight>70</read_weight>
    </read_write_split>
    -->
</parameters>